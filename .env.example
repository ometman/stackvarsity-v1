# ==============================================================================
# Stack Varsity V1 — Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit `.env.local`, `.env.production`, or real credentials to Git.
# ==============================================================================

# --- Application (Public & Runtime) -------------------------------------------
NEXT_PUBLIC_APP_NAME="Stack Varsity"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (PostgreSQL / Prisma — Configured in Step 1.7) ------------------
# Required once database features are active.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stackvarsity_dev?schema=public"

# --- Authentication (Auth.js — Planned Phase 2, Optional Now) -----------------
# Generate a strong random secret (32+ chars) when enabling Auth.js.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Payments (Paystack — Planned Phase 7, Optional Now) ----------------------
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# --- Transactional Email (Planned Phase 8, Optional Now) ----------------------
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="Stack Varsity <hello@mystackvarsity.com>"
